# Safe template only. Copy to .env locally and replace placeholders; never commit real values.
# Windows integrated authentication is recommended for local development when available.
PW_LOCKER_SQL_SERVER=YOUR_SQL_SERVER_NAME_OR_INSTANCE
PW_LOCKER_SQL_DATABASE=YOUR_EXISTING_VAULT_DATABASE
PW_LOCKER_SQL_AUTH_MODE=integrated

# SQL authentication only: change AUTH_MODE to sql and uncomment both placeholder values.
# PW_LOCKER_SQL_USERNAME=YOUR_DEDICATED_SQL_LOGIN
# PW_LOCKER_SQL_PASSWORD=YOUR_DEDICATED_SQL_LOGIN_PASSWORD

# Optional overrides. The shown values are the secure implementation defaults.
# PW_LOCKER_SQL_DRIVER=ODBC Driver 18 for SQL Server
# PW_LOCKER_SQL_CONNECT_TIMEOUT=15
